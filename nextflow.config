/*
 * GBS-Genomics-Pipeline — Nextflow configuration
 *
 * Portable configuration for:
 *
 *   - Local workstations
 *   - Docker
 *   - Singularity / Apptainer
 *   - Conda
 *   - SLURM / HPC
 *
 * Resource allocation is process-specific.
 *
 * DESIGN PRINCIPLES
 * -----------------
 *
 * This configuration does not impose a fixed sample-count limit.
 *
 * CPU and memory are assigned according to process requirements.
 *
 * AMRFinderPlus has a dedicated resource class because its
 * nucleotide-search workflow may invoke BLASTX, which can require
 * substantially more memory than lightweight pipeline stages.
 *
 * AMRFinderPlus concurrency is controlled independently with
 * amrfinder_max_forks.
 *
 * IMPORTANT:
 *
 * amrfinder_max_forks controls the number of AMRFinderPlus tasks
 * allowed to run concurrently. It does NOT limit the number of
 * samples in the dataset.
 *
 * Therefore:
 *
 *   amrfinder_max_forks = 1
 *
 * means:
 *
 *   one AMRFinderPlus task at a time
 *
 * and does NOT mean:
 *
 *   one sample only
 *
 * A dataset containing 20, 100, 1000, or more samples can still
 * be processed. The AMRFinderPlus tasks are simply scheduled
 * sequentially when this value is set to 1.
 *
 * Users with larger machines or HPC resources can increase
 * AMRFinderPlus concurrency at runtime, for example:
 *
 *   --amrfinder_max_forks 2
 *   --amrfinder_max_forks 4
 *
 * Resource values can also be overridden at runtime:
 *
 *   --max_cpus 16
 *   --max_memory '32 GB'
 *   --amrfinder_cpus 4
 *   --amrfinder_memory '16 GB'
 *
 * These parameters describe process resources, not sample counts.
 */

nextflow.enable.dsl = 2


// ============================================================
// Pipeline parameters
// ============================================================

params {

    // --------------------------------------------------------
    // Input
    // --------------------------------------------------------

    raw_dir = false

    curated_dir = false


    // --------------------------------------------------------
    // Output
    // --------------------------------------------------------

    outdir = "./results"


    // --------------------------------------------------------
    // Reference data
    // --------------------------------------------------------

    blast_db_dir =
        "${projectDir}/references/streptococcus_genus_db"

    background_ref_url =
        "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/009/585/GCF_000009585.1_ASM958v1/GCF_000009585.1_ASM958v1_genomic.fna.gz"


    // --------------------------------------------------------
    // MLST
    // --------------------------------------------------------

    mlst_scheme = "sagalactiae"


    // --------------------------------------------------------
    // Assembly quality
    // --------------------------------------------------------

    min_n50 = 10000

    min_length = 1800000

    max_length = 2400000

    max_contigs = 200


    // --------------------------------------------------------
    // Annotation
    // --------------------------------------------------------

    skip_tbl2asn = true


    // ========================================================
    // GENERAL RESOURCE SETTINGS
    // ========================================================
    //
    // These are configurable process-resource ceilings.
    //
    // They are NOT:
    //
    //   - sample limits
    //   - dataset limits
    //   - AMRFinderPlus sample limits
    //
    // ========================================================

    /*
     * Maximum CPU allocation available to processes using
     * the high-compute resource class.
     *
     * This is a process-resource ceiling, not a sample-count
     * setting.
     */

    max_cpus = 8


    /*
     * Maximum memory allocation available to processes using
     * the high-compute resource class.
     *
     * AMRFinderPlus has a separate memory setting below.
     */

    max_memory = '16 GB'


    // ========================================================
    // AMRFinderPlus RESOURCE SETTINGS
    // ========================================================
    //
    // AMRFinderPlus receives a dedicated resource class because
    // nucleotide searching can invoke BLASTX.
    //
    // BLASTX can consume substantially more memory than many
    // other pipeline processes.
    //
    // These settings control resources for each AMRFinderPlus
    // task. They do not control the number of samples.
    //
    // ========================================================

    /*
     * CPUs requested by AMRFinderPlus.
     *
     * Four CPUs provide reasonable parallelism while remaining
     * portable across workstations and HPC systems.
     */

    amrfinder_cpus = 4


    /*
     * Memory requested by each AMRFinderPlus task.
     *
     * The previous allocation of 8 GB was insufficient for the
     * observed BLASTX workload.
     *
     * The observed OOM events showed individual BLASTX processes
     * reaching several GB of RSS and, in one run, approximately
     * 12.4 GiB RSS.
     *
     * Fourteen GB therefore provides substantially more headroom
     * for the default workstation configuration.
     *
     * This is a per-task resource request.
     */

    amrfinder_memory = '14 GB'


    /*
     * Maximum number of AMRFinderPlus tasks allowed to run
     * concurrently.
     *
     * This is a concurrency setting only.
     *
     * It does NOT limit the number of samples that can enter
     * the AMRFinderPlus process.
     *
     * With a value of 1:
     *
     *   Sample 1 -> AMRFinderPlus
     *   Sample 2 -> AMRFinderPlus
     *   Sample 3 -> AMRFinderPlus
     *   ...
     *   Sample 100 -> AMRFinderPlus
     *
     * all samples are processed, one AMRFinderPlus task at a time.
     *
     * A value of 1 is the safe default for workstations with
     * approximately 24 GB RAM because multiple BLASTX workloads
     * can otherwise exhaust available memory.
     *
     * Users with larger systems can override this at runtime.
     *
     * Example:
     *
     *   --amrfinder_max_forks 2
     *   --amrfinder_max_forks 4
     */

    amrfinder_max_forks = 1


    // --------------------------------------------------------
    // Help
    // --------------------------------------------------------

    help = false
}


// ============================================================
// Execution profiles
// ============================================================

profiles {


    // ========================================================
    // Docker
    // ========================================================

    docker {

        docker.enabled = true

        process.container =
            'kizitodevbio/strepto-pipeline:v1.2.0'
    }


    // ========================================================
    // Singularity / Apptainer
    // ========================================================

    singularity {

        singularity.enabled = true

        singularity.autoMounts = true

        singularity.cacheDir =
            "${launchDir}/.singularity_cache"

        process.container =
            'docker://kizitodevbio/strepto-pipeline:v1.2.0'
    }


    // ========================================================
    // Conda
    // ========================================================

    conda {

        conda.enabled = true

        conda.cacheDir =
            "${projectDir}/.conda_cache"

        conda.channels =
            [
                'conda-forge',
                'bioconda',
                'defaults'
            ]

        conda.createOptions =
            '--strict-channel-priority'
    }


    // ========================================================
    // SLURM / HPC
    // ========================================================

    cluster {

        process.executor = 'slurm'

        process.time = '12.h'
    }


    // ========================================================
    // Test
    // ========================================================

    test {

        params.outdir =
            "./test_results"

        params.min_n50 =
            1000
    }
}


// ============================================================
// Process configuration
// ============================================================

process {


    // --------------------------------------------------------
    // Default container
    // --------------------------------------------------------

    container =
        'kizitodevbio/strepto-pipeline:v1.2.0'


    // --------------------------------------------------------
    // Default resources
    // --------------------------------------------------------
    //
    // Individual process labels override these defaults.
    //

    cpus = 1

    memory = '2 GB'


    // --------------------------------------------------------
    // Retry handling
    // --------------------------------------------------------
    //
    // Exit 137 commonly indicates SIGKILL, including memory
    // pressure in containerized execution.
    //
    // The retry mechanism allows transient failures to retry
    // without imposing a sample-count restriction.
    //

    errorStrategy = {

        task.exitStatus in
            [
                143,
                137,
                104,
                134,
                139
            ]
            ? 'retry'
            : 'terminate'
    }

    maxRetries = 2

    maxErrors = '-1'

    cache = 'lenient'


    // ========================================================
    // LOW COMPUTE
    // ========================================================

    withLabel: 'low_compute' {

        cpus = 1

        memory = '2 GB'
    }


    // ========================================================
    // MEDIUM COMPUTE
    // ========================================================

    withLabel: 'med_compute' {

        cpus = {

            Math.min(
                4,
                params.max_cpus as int
            )
        }

        memory = '4 GB'
    }


    // ========================================================
    // AMRFinderPlus HIGH-MEMORY RESOURCE CLASS
    // ========================================================
    //
    // This label matches:
    //
    //   label 'amrfinder_high_memory'
    //
    // in:
    //
    //   modules/amrfinderplus/amrfinderplus.nf
    //
    // This configuration therefore changes the resources
    // available to AMRFinderPlus without modifying the
    // AMRFinderPlus module itself.
    //
    // ========================================================

    withLabel: 'amrfinder_high_memory' {

        cpus = {

            Math.min(
                params.amrfinder_cpus as int,
                params.max_cpus as int
            )
        }

        memory = {

            params.amrfinder_memory
        }

        maxForks = params.amrfinder_max_forks as int
    }


    // ========================================================
    // HIGH COMPUTE
    // ========================================================
    //
    // High-compute processes use the general resource ceiling.
    //
    // AMRFinderPlus remains independently controlled by its
    // dedicated resource class above.
    //

    withLabel: 'high_compute' {

        cpus = {

            params.max_cpus as int
        }

        memory = {

            params.max_memory
        }
    }
}


// ============================================================
// Execution reports
// ============================================================

timeline {

    enabled = true

    file =
        "${params.outdir}/Logs/timeline.html"

    overwrite = true
}


report {

    enabled = true

    file =
        "${params.outdir}/Logs/report.html"

    overwrite = true
}


trace {

    enabled = true

    file =
        "${params.outdir}/Logs/trace.txt"

    overwrite = true
}


dag {

    enabled = true

    file =
        "${params.outdir}/Logs/dag.svg"

    overwrite = true
}


// ============================================================
// Local executor
// ============================================================
//
// queueSize controls the local executor task queue.
//
// It is NOT a sample-count setting.
//
// AMRFinderPlus has its own maxForks restriction, so other
// independent pipeline processes can still be scheduled while
// AMRFinderPlus remains limited to its configured concurrency.
//
// ============================================================

executor {

    name = 'local'

    queueSize = 8
}

